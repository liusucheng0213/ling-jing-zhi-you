# ============================================
# DeepSeek-V4 API配置
# 获取地址：https://platform.deepseek.com/
# ============================================
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
DEEPSEEK_MODEL=deepseek-v4-flash

# ============================================
# 讯飞开放平台配置
# 获取地址：https://www.xfyun.cn/
# 需要开通：语音识别、语音合成、虚拟数字人
# ============================================
XFYUN_APP_ID=your-xfyun-app-id
XFYUN_API_KEY=your-xfyun-api-key
XFYUN_API_SECRET=your-xfyun-api-secret
XFYUN_TTS_URL=wss://tts-api.xfyun.cn/v2/tts
XFYUN_TTS_VCN=xiaoyan
XFYUN_TTS_AUE=lame
XFYUN_TTS_SAMPLE_RATE=16000
XFYUN_AVATAR_SERVER_URL=wss://avatar.cn-huadong-1.xf-yun.com/v1/interact
XFYUN_AVATAR_SCENE_ID=your-interface-service-scene-id
# 五个展示角色的 Avatar ID。新建接口服务后请全部核对，不要沿用其他账号的示例 ID。
XFYUN_AVATAR_LINGXIAOCHAN_ID=your-lingxiaochan-avatar-id
XFYUN_AVATAR_WUCHANSHI_ID=your-wuchanshi-avatar-id
XFYUN_AVATAR_XUANZANG_ID=your-xuanzang-avatar-id
XFYUN_AVATAR_ZHAOPUCHU_ID=your-zhaopuchu-avatar-id
XFYUN_AVATAR_XIAOWAN_ID=your-xiaowan-avatar-id
# 以下 VCN 仅在新接口没有授权当前音色时修改。
XFYUN_AVATAR_LINGXIAOCHAN_VCN=x4_lingxiaoxuan_oral
XFYUN_AVATAR_WUCHANSHI_VCN=x4_mingge
XFYUN_AVATAR_XUANZANG_VCN=x4_lingfeizhe_oral
XFYUN_AVATAR_ZHAOPUCHU_VCN=x4_mingge
XFYUN_AVATAR_XIAOWAN_VCN=x4_lingxiaoyue_oral_emo
XFYUN_AVATAR_VCN=x4_lingxiaoxuan_oral
XFYUN_AVATAR_STREAM_PROTOCOL=xrtc
XFYUN_AVATAR_WIDTH=1080
XFYUN_AVATAR_HEIGHT=1920
XFYUN_AVATAR_FPS=20
XFYUN_AVATAR_BITRATE=800000
# 仅比赛/内网演示可设true让WebSDK直接拿apiKey/apiSecret；生产应改后端签名signedUrl
XFYUN_AVATAR_EXPOSE_SECRET_TO_FRONTEND=false
# 讯飞数字人背景资源：
# - 若填原始图片 base64，XFYUN_AVATAR_BACKGROUND_TYPE 通常使用 background_data
# - 若填讯飞控制台上传后返回的资源 ID，按返回字段使用 res_id 或 res_key
# - 真实生效需浏览器 WebSDK 画面和讯飞控制台素材状态共同验收
XFYUN_AVATAR_BACKGROUND_RES_KEY=
XFYUN_AVATAR_BACKGROUND_TYPE=res_key

# ============================================
# 数据库配置（Docker Compose使用）
# ============================================
DATABASE_URL=postgresql+asyncpg://user:pass@postgres:5432/lingjing
REDIS_URL=redis://redis:6379/0

# ============================================
# 本地BGE-M3嵌入模型
# ============================================
EMBEDDING_MODEL_PATH=./models/bge-m3
USE_LOCAL_EMBEDDING=true
EMBEDDING_DEVICE=cuda
EMBEDDING_LOCAL_BACKEND=sentence-transformers
# 默认使用仓库内规范化 A5 JSON；只有需要重新聚合本地原始 DOCX/XLSX 时才设为 true。
INGEST_RAW_PUBLIC_MATERIALS=false
# embedding 容器默认安装 CUDA 版 PyTorch；无 GPU 时可改为 CPU 轮子源后重建镜像
EMBEDDING_BASE_IMAGE=pytorch/pytorch:2.6.0-cuda12.4-cudnn9-runtime
PYTORCH_WHEEL_INDEX_URL=https://download.pytorch.org/whl/cu124

# ============================================
# 多模态图片能力（默认关闭）
# ============================================
# 未配置时后端只返回“未启用”状态，不会按文件名伪造图片识别结果
# 阿里百炼（默认示例）
VISION_PROVIDER=aliyun_bailian
VISION_API_KEY=
VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_MODEL=qwen3.6-flash-2026-04-16
# 如改用 Kimi 开放平台，请将上面四项改为：
# VISION_PROVIDER=kimi
# VISION_API_KEY=在 platform.kimi.com 单独创建的 API Key（Kimi 会员不能代替）
# VISION_BASE_URL=https://api.moonshot.cn/v1
# VISION_MODEL=kimi-k2.6
# Kimi Code 会员通道使用独立地址和模型（与开放平台密钥不可混用）：
# VISION_PROVIDER=kimi_code
# VISION_API_KEY=在 Kimi Code 会员控制台创建的 API Key
# VISION_BASE_URL=https://api.kimi.com/coding/v1
# VISION_MODEL=kimi-for-coding
# 已开通 HighSpeed 权益时可改为 kimi-for-coding-highspeed，以缩短图片理解等待时间
# ============================================
# 安全密钥（生产环境请修改）
# ============================================
JWT_SECRET=your-secret-key-change-in-production
# 管理后台账号。生产和演示环境都必须改为非默认强密码。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ============================================
# 调试模式
# ============================================
DEBUG=true
