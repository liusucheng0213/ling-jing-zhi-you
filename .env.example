# 复制为根目录 .env 后只填写密钥。不要提交 .env。
# 密钥留空。非密钥项与当前代码或 Compose 默认值一致，避免复制后改变行为。
# 某一行如果整行删除，程序会使用代码里的默认值；写成空字符串则会覆盖默认值。

# ============================================
# DeepSeek
# TODO: 配置你的 DEEPSEEK_API_KEY，获取方式：https://platform.deepseek.com/
# ============================================
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_MODEL_PRO=deepseek-v4-pro
LLM_TIMEOUT=12.0
LLM_MAX_RETRIES=3
LLM_MAX_TOKENS=650
LLM_TEMPERATURE=1.0
LLM_TOP_P=1.0

# ============================================
# 讯飞开放平台
# TODO: 配置你的 XFYUN_APP_ID、XFYUN_API_KEY、XFYUN_API_SECRET，获取方式：https://console.xfyun.cn/
# 需要开通：语音识别、语音合成、虚拟数字人
# ============================================
XFYUN_APP_ID=
XFYUN_API_KEY=
XFYUN_API_SECRET=
XFYUN_TTS_URL=wss://tts-api.xfyun.cn/v2/tts
XFYUN_TTS_VCN=xiaoyan
XFYUN_TTS_AUE=lame
XFYUN_TTS_SAMPLE_RATE=16000
XFYUN_AVATAR_SERVER_URL=wss://avatar.cn-huadong-1.xf-yun.com/v1/interact
# TODO: 配置你的 XFYUN_AVATAR_SCENE_ID，获取方式：https://www.xfyun.cn/ 虚拟人接口服务
XFYUN_AVATAR_SCENE_ID=
# 形象 ID 留空。Docker Compose 会把空值传进容器并覆盖 config.py 的回退编号。
# 不需要覆盖时请删除下面五行。回退编号见 backend/app/config.py。
XFYUN_AVATAR_LINGXIAOCHAN_ID=
XFYUN_AVATAR_WUCHANSHI_ID=
XFYUN_AVATAR_XUANZANG_ID=
XFYUN_AVATAR_ZHAOPUCHU_ID=
XFYUN_AVATAR_XIAOWAN_ID=
XFYUN_AVATAR_LINGXIAOCHAN_VCN=x4_lingxiaoxuan_oral
XFYUN_AVATAR_WUCHANSHI_VCN=x4_mingge
XFYUN_AVATAR_XUANZANG_VCN=x4_lingfeizhe_oral
XFYUN_AVATAR_ZHAOPUCHU_VCN=x4_mingge
XFYUN_AVATAR_XIAOWAN_VCN=x4_lingxiaoyue_oral_emo
XFYUN_AVATAR_VCN=x4_lingxiaoxuan_oral
XFYUN_AVATAR_STREAM_PROTOCOL=xrtc
XFYUN_AVATAR_WIDTH=1080
XFYUN_AVATAR_HEIGHT=1920
XFYUN_AVATAR_FPS=20
XFYUN_AVATAR_BITRATE=800000
# 仅内网演示可设 true，让 WebSDK 直接拿到 apiKey/apiSecret。生产保持 false，走后端签名。
XFYUN_AVATAR_EXPOSE_SECRET_TO_FRONTEND=false
XFYUN_AVATAR_BACKGROUND_RES_KEY=
XFYUN_AVATAR_BACKGROUND_TYPE=res_key

# ============================================
# 数据库与缓存
# 容器内主机名是 postgres。在宿主机直接跑 Python 时把主机名改成 localhost，
# 或删除 DATABASE_URL 以使用代码默认值。
# user/pass 只供本机 Compose，不要用于公网。
# ============================================
DATABASE_URL=postgresql+asyncpg://user:pass@postgres:5432/lingjing
DATABASE_POOL_SIZE=20
REDIS_URL=redis://redis:6379/0
CACHE_TTL=3600
VECTOR_DIMENSION=1024

# ============================================
# 本地 BGE-M3 嵌入模型
# 权重不在仓库内。下载方式见 README「大文件」。
# ============================================
EMBEDDING_MODEL_PATH=./models/bge-m3
EMBEDDING_DIMENSION=1024
USE_LOCAL_EMBEDDING=true
EMBEDDING_DEVICE=cuda
EMBEDDING_LOCAL_BACKEND=sentence-transformers
EMBEDDING_SERVICE_URL=
EMBEDDING_BASE_IMAGE=pytorch/pytorch:2.6.0-cuda12.4-cudnn9-runtime
PYTORCH_WHEEL_INDEX_URL=https://download.pytorch.org/whl/cu124
NVIDIA_VISIBLE_DEVICES=all
# 只有需要重新聚合本机原始 DOCX/XLSX 时才设为 true。
INGEST_RAW_PUBLIC_MATERIALS=false
# 删除本行则使用仓库上一级的「示范景区公开资料包」目录。不要写成空字符串。
# PUBLIC_MATERIAL_DIR=

# ============================================
# 多模态图片
# TODO: 配置你的 VISION_API_KEY，获取方式：https://bailian.console.aliyun.com/
# 未填写时图片能力返回“未启用”，不会按文件名伪造识别结果。
# Kimi 开放平台：https://platform.kimi.com ，模型 kimi-k2.6，地址 https://api.moonshot.cn/v1
# Kimi Code 与开放平台的密钥、地址、模型不能混用。
# ============================================
VISION_PROVIDER=aliyun_bailian
VISION_API_KEY=
VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_MODEL=qwen3.6-flash-2026-04-16

# ============================================
# 安全
# TODO: 配置你的 JWT_SECRET，获取方式：本地生成随机长字符串
# 下面的值与代码默认值相同，只适合本机。公网部署必须换成新的随机字符串。
# TODO: 配置你的 ADMIN_PASSWORD，获取方式：自行设置强密码
# ============================================
JWT_SECRET=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ============================================
# 应用与前端
# 宿主机 npm run dev 使用下面的 Vite 变量。
# Docker Compose 会在容器内单独把 VITE_DEV_API_TARGET 设为 http://api:8000。
# ============================================
APP_NAME=灵境智游AI导览系统
APP_VERSION=1.1.0
DEBUG=false
VITE_API_BASE_URL=
VITE_DEV_API_TARGET=http://localhost:8000
