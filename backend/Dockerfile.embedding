# CUDA 优先：PyTorch runtime 镜像已内置 torch + CUDA runtime，
# 避免在构建阶段逐个下载 nvidia-* wheel 导致网络超时。
ARG EMBEDDING_BASE_IMAGE=pytorch/pytorch:2.6.0-cuda12.4-cudnn9-runtime
FROM ${EMBEDDING_BASE_IMAGE}

WORKDIR /app

ARG PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
# 如使用 python:3.11-slim 等非 PyTorch 基础镜像，可通过该源安装 torch。
ARG TORCH_WHEEL_INDEX_URL=https://download.pytorch.org/whl/cu124
ARG PIP_DEFAULT_TIMEOUT=180
ARG PIP_RETRIES=10

ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility
ENV PIP_DEFAULT_TIMEOUT=${PIP_DEFAULT_TIMEOUT}

COPY requirements.txt .
COPY requirements_embedding.txt .

RUN pip install --no-cache-dir --retries ${PIP_RETRIES} -i ${PIP_INDEX_URL} -r requirements.txt
RUN pip install --no-cache-dir --retries ${PIP_RETRIES} -i ${PIP_INDEX_URL} --extra-index-url ${TORCH_WHEEL_INDEX_URL} -r requirements_embedding.txt

COPY app/ ./app/
COPY scripts/ ./scripts/

CMD ["python", "-m", "scripts.generate_embeddings", "--concurrency", "1"]
